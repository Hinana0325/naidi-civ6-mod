<?xml version="1.0" encoding="utf-8"?>
<Mod id="290AF11F-24C4-4091-B8A1-F988D6004C09" version="1">
	<Properties>
		<Name>奶家（奶蛙）</Name>
		<Teaser>奶蛙梗文明：万物皆可奶</Teaser>
		<Description>以奶蛙为主题的文明 6 模组：所有城市 +1 食物、+1 文化，首都奶蛙大学。</Description>
		<Authors>jq200</Authors>
		<EnabledByDefault>0</EnabledByDefault>
		<CompatibleVersions>1.2,2.0</CompatibleVersions>
	</Properties>
	<InGameActions>
		<UpdateDatabase id="NaiwaGameplay">
			<File>Data/NaiwaCiv_Civilizations.xml</File>
			<File>Data/NaiwaCiv_Leaders.xml</File>
			<File>Data/NaiwaCiv_Units.xml</File>
		</UpdateDatabase>
		<UpdateText id="NaiwaText">
			<File>Text/NaiwaCiv_ConfigText.xml</File>
			<File>Text/NaiwaCiv_Text.xml</File>
		</UpdateText>
		<UpdateIcons id="NaiwaIcons">
			<File>Data/NaiwaCiv_Icons.xml</File>
		</UpdateIcons>
	</InGameActions>
	<FrontEndActions>
		<UpdateDatabase id="NaiwaConfig">
			<File>Data/NaiwaCiv_Config.xml</File>
		</UpdateDatabase>
		<UpdateText id="NaiwaConfigText">
			<File>Text/NaiwaCiv_ConfigText.xml</File>
		</UpdateText>
		<UpdateIcons id="NaiwaConfigIcons">
			<File>Data/NaiwaCiv_Icons.xml</File>
		</UpdateIcons>
	</FrontEndActions>
