<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" DefaultTargets="Default" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <Name>奶家 · 奶帝</Name>
    <Authors>jq200</Authors>
    <Guid>290AF11F-24C4-4091-B8A1-F988D6004C09</Guid>
    <ProjectGuid>466A0488-DA7B-4F36-80D6-9D9B0BFF8606</ProjectGuid>
    <ModVersion>3</ModVersion>
    <Teaser>奶帝登基，万物皆可奶。</Teaser>
    <Description>「奶帝」网络梗文明：领袖奶帝（奶魂觉醒：所有城市 +1 生产力），文明奶家（万物皆可奶：所有城市 +2 食物、+1 文化）。三个特色兵种：奶狗（视野4/移动4 侦察）、奶蛋（战力24 近战，造价更低）、奶鸡（建造次数4）。首都奶蛙大学，含领袖立绘、加载页、自定义议程「奶化世界」。</Description>
    <AffectsSavedGames>false</AffectsSavedGames>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>true</SupportsMultiplayer>
    <SupportsHotSeat>true</SupportsHotSeat>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
    <InGameActionData><![CDATA[<InGameActions><UpdateDatabase id="NaiwaGameplay"><File>Data/NaiwaCiv_Civilizations.xml</File><File>Data/NaiwaCiv_Leaders.xml</File><File>Data/NaiwaCiv_Units.xml</File></UpdateDatabase><UpdateText id="NaiwaText"><File>Text/NaiwaCiv_ConfigText.xml</File><File>Text/NaiwaCiv_Text.xml</File></UpdateText><UpdateIcons id="NaiwaIcons"><File>Data/NaiwaCiv_Icons.xml</File></UpdateIcons><UpdateArt id="NaiwaArt"><File>NaiwaCiv.dep</File></UpdateArt></InGameActions>]]></InGameActionData>
    <FrontEndActionData><![CDATA[<FrontEndActions><UpdateDatabase id="NaiwaConfig"><File>Data/NaiwaCiv_Config.xml</File></UpdateDatabase><UpdateText id="NaiwaConfigText"><File>Text/NaiwaCiv_ConfigText.xml</File></UpdateText><UpdateIcons id="NaiwaConfigIcons"><File>Data/NaiwaCiv_Icons.xml</File></UpdateIcons></FrontEndActions>]]></FrontEndActionData>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' ">
    <OutputPath>.</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Data\NaiwaCiv_Civilizations.xml" />
    <Content Include="Data\NaiwaCiv_Config.xml" />
    <Content Include="Data\NaiwaCiv_Icons.xml" />
    <Content Include="Data\NaiwaCiv_Leaders.xml" />
    <Content Include="Data\NaiwaCiv_Units.xml" />
    <Content Include="Text\NaiwaCiv_ConfigText.xml" />
    <Content Include="Text\NaiwaCiv_Text.xml" />
    <Content Include="Icons\ICON_CIVILIZATION_NAIWA_22.dds" />
    <Content Include="Icons\ICON_CIVILIZATION_NAIWA_256.dds" />
    <Content Include="Icons\ICON_CIVILIZATION_NAIWA_30.dds" />
    <Content Include="Icons\ICON_CIVILIZATION_NAIWA_36.dds" />
    <Content Include="Icons\ICON_CIVILIZATION_NAIWA_44.dds" />
    <Content Include="Icons\ICON_CIVILIZATION_NAIWA_45.dds" />
    <Content Include="Icons\ICON_CIVILIZATION_NAIWA_48.dds" />
    <Content Include="Icons\ICON_CIVILIZATION_NAIWA_50.dds" />
    <Content Include="Icons\ICON_CIVILIZATION_NAIWA_64.dds" />
    <Content Include="Icons\ICON_CIVILIZATION_NAIWA_80.dds" />
    <Content Include="Icons\ICON_LEADER_NAIWA_256.dds" />
    <Content Include="Icons\ICON_LEADER_NAIWA_32.dds" />
    <Content Include="Icons\ICON_LEADER_NAIWA_45.dds" />
    <Content Include="Icons\ICON_LEADER_NAIWA_50.dds" />
    <Content Include="Icons\ICON_LEADER_NAIWA_55.dds" />
    <Content Include="Icons\ICON_LEADER_NAIWA_64.dds" />
    <Content Include="Icons\ICON_LEADER_NAIWA_80.dds" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="ArtDefs\FallbackLeaders.artdef" />
    <Content Include="XLPs\UILeaders.xlp" />
    <Content Include="XLPs\LeaderFallbacks.xlp" />
    <Content Include="Textures\FALLBACK_NEUTRAL_NAIDI.dds" />
    <Content Include="Textures\FALLBACK_NEUTRAL_NAIDI.tex" />
    <Content Include="Textures\LEADER_NAIDI_BACKGROUND.dds" />
    <Content Include="Textures\LEADER_NAIDI_BACKGROUND.tex" />
    <Content Include="Textures\LEADER_NAIDI_EMPTY.dds" />
    <Content Include="Textures\LEADER_NAIDI_EMPTY.tex" />
    <Content Include="Textures\LEADER_NAIDI_NEUTRAL.dds" />
    <Content Include="Textures\LEADER_NAIDI_NEUTRAL.tex" />
    <None Include="NaiwaCiv.Art.xml" />
  </ItemGroup>
  <Import Project="$(MSBuildLocalExtensionPath)Civ6.targets"/>
</Project>
